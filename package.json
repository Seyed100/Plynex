{
  "name": "plynex-player",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run prepare:runtime && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build",
    "check": "tsc -b && cargo check --manifest-path src-tauri/Cargo.toml",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "test:engine": "node scripts/verify-mpv.mjs",
    "test:preferences": "node scripts/test-preferences.mjs",
    "test:ui": "node scripts/qa-ui.mjs && node scripts/qa-playback-layout.mjs",
    "test:native": "node scripts/qa-native.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource-variable/vazirmatn": "^5.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "vite": "^6.3.0"
  }
}
